<!--
  Hidden in Plain Sight: LOLBins Detection Lab
  Custom Wazuh rules (Wazuh 4.9.x)

  Location on the Wazuh Manager:
    /var/ossec/etc/rules/local_rules.xml

  Install: APPEND the <group> below to the existing local_rules.xml.
  Do not delete the default file, it contains Wazuh's example rule 100001.

  Apply:
    sudo /var/ossec/bin/wazuh-analysisd -t        (syntax check, no output means OK)
    sudo systemctl restart wazuh-manager          (a full restart, not a partial reload)

  Required on the Windows endpoint (see technical-diary.md, sections 0 and 4):
    - PowerShell Script Block Logging enabled (Event ID 4104)
    - Command line auditing enabled (Event ID 4688 with command line)
    - Wazuh agent collecting these channels:
        Microsoft-Windows-PowerShell/Operational
        Microsoft-Windows-Sysmon/Operational
        Security (collected by default)

  Rule status in the lab:
    100010  WORKING   alerts verified on wintarget (Level 12)
    100011  WORKING   alerts verified (3 alerts, Level 12)
    100012  UNVERIFIED  Sysmon EID 13 was detected by the built-in rule 92302
                        (Level 6); this custom rule did not surface as the final
                        alert. See technical-diary.md, section 6

  Lab use only. Tune before using anywhere else
  (see reports/soc-report.md, finding F-02 and recommendation 4).
-->
<group name="lolbins,purple_team,">

  <!-- IR-01: any PowerShell Script Block (Event ID 4104).
       Broad on purpose for the lab. In production narrow it with scriptBlockText
       patterns (Net.WebClient, DownloadString, IEX) to reduce noise. -->
  <rule id="100010" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4104$</field>
    <description>PowerShell Script Block Execution Detected</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- IR-02: certutil used with -urlcache (file download).
       Builds on the generic "A process was created" rule 67027 (Level 3). -->
  <rule id="100011" level="12">
    <if_sid>67027</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)certutil.*-urlcache</field>
    <description>Suspicious certutil LOLBin download attempt detected</description>
    <mitre>
      <id>T1105</id>
      <id>T1140</id>
    </mitre>
  </rule>

  <!-- IR-03: Run key persistence via Sysmon Event ID 13 (Registry value set).
       Lab version: no if_sid, matches the event fields directly.
       It passed wazuh-logtest with a synthetic event, but the real event
       surfaced as the built-in rule 92302 instead. UNVERIFIED as a final alert,
       see the header. -->
  <rule id="100012" level="12">
    <field name="win.system.eventID">^13$</field>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)CurrentVersion\\Run\\</field>
    <description>Registry Run Key persistence detected (Sysmon EID 13)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

</group>
